#!/usr/bin/env node
// Stand-in for the real `claude` CLI in print mode. Written with dynamic
// import() only so it runs whether Node treats this extensionless file as
// CommonJS or ESM. Reads the prompt from stdin, like `claude -p` with no
// positional prompt.

const argv = process.argv.slice(2)
const mode = process.env.FAKE_CLAUDE_MODE || 'ok'

const requiredFlags = [
  '-p',
  '--output-format',
  '--json-schema',
  '--mcp-config',
  '--strict-mcp-config',
  '--restricted',
  '--allowedTools',
  '--permission-prompts',
  '--no-session-persistence',
]

function fail(message) {
  process.stderr.write(`fake-claude: ${message}\n`)
  process.exit(2)
}

function valueOf(flag) {
  const i = argv.indexOf(flag)
  return i === -1 ? undefined : argv[i + 1]
}

function readStdin() {
  return new Promise((resolve, reject) => {
    let data = ''
    process.stdin.setEncoding('utf8')
    process.stdin.on('data', (chunk) => (data += chunk))
    process.stdin.on('end', () => resolve(data))
    process.stdin.on('error', reject)
  })
}

function parseEntries(prompt) {
  const entries = []
  for (const line of prompt.split('\n')) {
    // Translate prompts number their entries; audit prompts emit bare JSON objects.
    const m = /^(?:\d+\. )?(\{.*\})$/.exec(line.trim())
    if (m) {
      try {
        const parsed = JSON.parse(m[1])
        if (typeof parsed.id === 'number') entries.push(parsed)
      } catch {}
    }
  }
  return entries
}

// The audit schema asks for a verdict per entry; the translate schema asks for text.
function isAuditSchema() {
  try {
    const schema = JSON.parse(valueOf('--json-schema'))
    return 'problem' in (schema.properties?.results?.items?.properties ?? {})
  } catch {
    return false
  }
}

function buildAuditResults(entries) {
  return entries.map((e) => {
    const bad = String(e.source).includes('BAD')
    // Default: only a source explicitly marked BAD is a problem, so a suspect the
    // rules only raised a hint about is left for the model to clear, same as a
    // real Claude might. FAKE_CLAUDE_CONFIRM_HINTS flips that off for tests that
    // need a rule-condemned or rule-suspected entry to come back with a fix.
    const hinted = Boolean(process.env.FAKE_CLAUDE_CONFIRM_HINTS) && (e.automatedChecks || []).length > 0
    const problem = bad || hinted
    const result = {
      id: e.id,
      problem,
      categories: problem ? ['meaning'] : [],
      reason: bad ? 'fake: source marked BAD' : hinted ? 'fake: confirming automated check' : 'fake: looks fine',
    }
    // A fix that keeps the source's placeholders and tags, so the rules accept
    // it. FAKE_CLAUDE_BAD_FIX makes it drop them, to exercise the rejection.
    if (problem) {
      const carried = String(e.source).match(/%[0-9$]*[sd]|<[^>]+>/g) || []
      result.fix = [process.env.FAKE_CLAUDE_BAD_FIX ? '[tr] onarildi' : `[tr] onarildi ${carried.join(' ')}`.trim()]
    }
    return result
  })
}

function buildResults(entries, nplurals) {
  return entries.map((e) => {
    const forms = e.msgidPlural ? nplurals : 1
    const text = []
    for (let i = 0; i < forms; i++) text.push('[tr] ' + (i === 0 ? e.msgid : e.msgidPlural))
    return { id: e.id, text, fuzzy: e.msgid.includes('Hook'), reason: 'fake' }
  })
}

// The real CLI decodes under the --json-schema it is given, so a payload that
// violates it is one the real model could never return. Checking it here keeps
// the schema honest against the prompt: a shape the prompt asks for but the
// schema forbids fails loudly in tests instead of in a live run.
function schemaErrors(value, schema, path) {
  const errors = []
  const at = path || 'output'
  if (!schema || typeof schema !== 'object') return errors

  if (schema.enum && !schema.enum.includes(value)) errors.push(`${at} is not one of ${schema.enum.join(', ')}`)

  switch (schema.type) {
    case 'object': {
      if (typeof value !== 'object' || value === null || Array.isArray(value)) {
        errors.push(`${at} is not an object`)
        break
      }
      for (const key of schema.required || []) {
        if (!(key in value)) errors.push(`${at}.${key} is required`)
      }
      for (const [key, child] of Object.entries(value)) {
        const childSchema = (schema.properties || {})[key]
        if (!childSchema) {
          if (schema.additionalProperties === false) errors.push(`${at}.${key} is not allowed`)
          continue
        }
        errors.push(...schemaErrors(child, childSchema, `${at}.${key}`))
      }
      break
    }
    case 'array': {
      if (!Array.isArray(value)) {
        errors.push(`${at} is not an array`)
        break
      }
      if (schema.minItems !== undefined && value.length < schema.minItems) {
        errors.push(`${at} has ${value.length} items, fewer than the ${schema.minItems} required`)
      }
      value.forEach((item, i) => errors.push(...schemaErrors(item, schema.items, `${at}[${i}]`)))
      break
    }
    case 'integer':
      if (!Number.isInteger(value)) errors.push(`${at} is not an integer`)
      else if (schema.minimum !== undefined && value < schema.minimum) errors.push(`${at} is below the minimum`)
      break
    case 'boolean':
      if (typeof value !== 'boolean') errors.push(`${at} is not a boolean`)
      break
    case 'string':
      if (typeof value !== 'string') errors.push(`${at} is not a string`)
      else if (schema.minLength !== undefined && value.length < schema.minLength) errors.push(`${at} is too short`)
      break
    default:
      break
  }
  return errors
}

function envelope(payload, extra) {
  return JSON.stringify({
    type: 'result',
    subtype: 'success',
    is_error: false,
    result: JSON.stringify(payload),
    structured_output: payload,
    ...extra,
  })
}

async function main() {
  const fs = await import('node:fs')

  if (process.env.FAKE_CLAUDE_ARGS_OUT) fs.writeFileSync(process.env.FAKE_CLAUDE_ARGS_OUT, JSON.stringify(argv))
  if (process.env.FAKE_CLAUDE_ENV_OUT) fs.writeFileSync(process.env.FAKE_CLAUDE_ENV_OUT, JSON.stringify(process.env))
  if (process.env.FAKE_CLAUDE_PID_OUT) fs.writeFileSync(process.env.FAKE_CLAUDE_PID_OUT, String(process.pid))
  if (process.env.FAKE_CLAUDE_SIGNAL_OUT) {
    const signalOut = process.env.FAKE_CLAUDE_SIGNAL_OUT
    process.on('SIGTERM', () => {
      fs.writeFileSync(signalOut, 'SIGTERM')
      if (mode !== 'hang-ignore-sigterm') process.exit(143)
    })
  }

  for (const flag of requiredFlags) if (!argv.includes(flag)) fail(`missing flag ${flag}`)
  if (valueOf('--output-format') !== 'json') fail('expected --output-format json')
  if (valueOf('--permission-prompts') !== 'none') fail('expected --permission-prompts none')
  try {
    JSON.parse(valueOf('--json-schema'))
  } catch {
    fail('--json-schema is not valid JSON')
  }
  if (argv.some((a) => a.includes('nplurals:'))) fail('prompt must arrive on stdin, not argv')

  if (mode === 'hang' || mode === 'hang-ignore-sigterm') {
    setTimeout(() => process.exit(0), 10_000)
    return
  }

  const prompt = await readStdin()
  if (process.env.FAKE_CLAUDE_STDIN_OUT) fs.writeFileSync(process.env.FAKE_CLAUDE_STDIN_OUT, prompt)
  if (prompt.length === 0) fail('Input must be provided either through stdin or as a prompt argument')

  const npluralsMatch = /nplurals: (\d+)/.exec(prompt)
  const nplurals = npluralsMatch ? Number(npluralsMatch[1]) : 1
  const entries = parseEntries(prompt)
  if (entries.length === 0) fail('no entries found in prompt')
  if (entries.some((e) => typeof e.id !== 'number' || 'key' in e)) fail('entries must carry an id and no key')

  const payload = { results: isAuditSchema() ? buildAuditResults(entries) : buildResults(entries, nplurals) }

  // Checked before the switch: the modes below corrupt the payload on purpose,
  // to stand in for a CLI that misbehaves after decoding.
  const invalid = schemaErrors(payload, JSON.parse(valueOf('--json-schema')))
  if (invalid.length > 0) fail(`output violates --json-schema: ${invalid.join('; ')}`)

  switch (mode) {
    case 'ok':
      process.stdout.write(envelope(payload) + '\n')
      return
    case 'result-only': {
      const env = JSON.parse(envelope(payload))
      delete env.structured_output
      process.stdout.write(JSON.stringify(env) + '\n')
      return
    }
    case 'malformed':
      process.stdout.write('this is not { json at all\n')
      return
    // Claude prints its usage-limit notice on stdout and exits non-zero, so this
    // mode reproduces a failure whose only explanation is in the stream the
    // runner used to discard.
    case 'quota':
      process.stdout.write('Claude usage limit reached. Your limit will reset at 3:00pm.\n')
      process.exit(1)
      break
    case 'exit1':
      process.stderr.write('fake claude failure: something went wrong\n')
      process.exit(1)
      break
    case 'missing-id':
      payload.results.splice(1, 1)
      process.stdout.write(envelope(payload) + '\n')
      return
    case 'duplicate-id':
      payload.results.push({ ...payload.results[0] })
      process.stdout.write(envelope(payload) + '\n')
      return
    case 'unknown-id':
      payload.results.push({ ...payload.results[0], id: 99 })
      process.stdout.write(envelope(payload) + '\n')
      return
    case 'short-plural': {
      const plural = payload.results.find((r) => r.text && r.text.length > 1)
      if (plural) plural.text = plural.text.slice(0, 1)
      process.stdout.write(envelope(payload) + '\n')
      return
    }
    case 'empty-text':
      payload.results[0].text = ['']
      process.stdout.write(envelope(payload) + '\n')
      return
    case 'is-error':
      process.stdout.write(
        JSON.stringify({ type: 'result', subtype: 'error', is_error: true, result: 'fake error result' }) + '\n',
      )
      return
    default:
      fail(`unknown FAKE_CLAUDE_MODE ${mode}`)
  }
}

main().catch((err) => fail(String(err && err.stack ? err.stack : err)))
