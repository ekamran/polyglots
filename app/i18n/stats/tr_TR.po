# Turkish strings of the polyglots stats page.
# Turkish capitalises only the first word of a heading and proper nouns, the
# same rule the review command enforces on contributors; a stats page that
# broke it while reporting on it would be quietly ridiculous.
msgid ""
msgstr ""
"Project-Id-Version: polyglots stats\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: tr\n"

