{
  // The snapshot scripts import app/src directly, so they are checked by the
  // app's own compiler under the app's own settings (npm run snapshot:check).
  // Astro's checker never sees them: it would hold app code to another
  // TypeScript version and another module resolution.
  "extends": "../../app/tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "typeRoots": ["../../app/node_modules/@types"]
  },
  "include": ["*.ts"]
}
