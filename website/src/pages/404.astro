---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Not found · polyglots" description="This page does not exist.">
  <section class="wrap nf">
    <pre class="term" aria-hidden="true"><span class="t-error">✗</span> No such page</pre>
    <h1>Nothing here</h1>
    <p>Try the <a href={base}>home page</a> or the <a href={`${base}docs/`}>docs</a>.</p>
  </section>
</Base>
<style>
  .nf { padding-top: 4rem; }
  .term { display: inline-block; padding: 0.75rem 1.1rem; margin-bottom: 1.5rem; }
  .t-error { color: var(--t-error); }
</style>
