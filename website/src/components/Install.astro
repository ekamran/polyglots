---
import CopyButton from './CopyButton.astro';

// Two ways in, as tabs. Radios rather than a script, so the tabs work before
// any JavaScript and the keyboard moves between them natively.
interface Props {
  /** Distinguishes the radio group when the page has more than one. */
  id: string;
}
const { id } = Astro.props;
const options = [
  { id: 'npm', label: 'npm', command: 'npm install -g polyglots' },
  { id: 'npx', label: 'npx', command: 'npx polyglots' },
];
const name = `install-${id}`;
---
<div class="install">
  <fieldset class="tabs">
    <legend class="sr-only">Install with</legend>
    {options.map((o, i) => (
      <label>
        <input type="radio" name={name} value={o.id} checked={i === 0} />
        <span>{o.label}</span>
      </label>
    ))}
  </fieldset>
  {options.map((o) => (
    <div class="cmd" data-for={o.id}>
      <code><span class="prompt" aria-hidden="true">$ </span>{o.command}</code>
      <CopyButton text={o.command} label={`Copy: ${o.command}`} />
    </div>
  ))}
  <p class="note muted">Needs Node.js 24 or later. npx runs it without installing.</p>
</div>

<style>
  .install { max-width: 34rem; }
  .tabs { display: flex; gap: 0.25rem; margin: 0 0 0.5rem; padding: 0; border: 0; }
  label { position: relative; }
  input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  label span {
    display: block; padding: 0.25rem 0.75rem; border-radius: 999px;
    font-family: var(--font-mono); font-size: 0.85rem; color: var(--muted);
  }
  label:has(input:checked) span { background: var(--accent-soft); color: var(--accent); }
  label:has(input:focus-visible) span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cmd {
    display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
    background: var(--term-bg); color: var(--term-fg);
    border-radius: var(--radius); padding: 0.4rem 0.4rem 0.4rem 1rem;
  }
  .cmd code { font-family: var(--font-mono); font-size: 0.95rem; white-space: nowrap; overflow-x: auto; background: none; border: 0; padding: 0; color: inherit; }
  .prompt { color: var(--term-dim); }
  /* npm shows by default, so a browser without :has() still gets a command. */
  .cmd[data-for='npx'],
  .install:has(input[value='npx']:checked) .cmd[data-for='npm'] { display: none; }
  .install:has(input[value='npx']:checked) .cmd[data-for='npx'] { display: flex; }
  .note { font-size: 0.875rem; margin: 0.6rem 0 0; }
</style>
